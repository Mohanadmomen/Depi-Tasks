@model Hall
@{
    ViewData["Title"] = "Add Hall";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card p-5">
            <h2 class="fw-bold text-white mb-4"><i class="bi bi-columns-gap text-primary"></i> Add Hall</h2>
            
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CinemaId" class="form-label">Cinema Location</label>
                    <select asp-for="CinemaId" class="form-select bg-dark border-secondary text-white" asp-items="ViewBag.Cinemas">
                        <option value="">-- Select Cinema --</option>
                    </select>
                    <span asp-validation-for="CinemaId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Hall Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. IMAX Theater" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Capacity" class="form-label">Seating Capacity</label>
                    <input asp-for="Capacity" type="number" class="form-control" placeholder="e.g. 100" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Save Hall</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
