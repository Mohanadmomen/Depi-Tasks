@model Movie
@{
    ViewData["Title"] = "Delete Movie";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card p-5 border-danger-subtle">
            <h2 class="fw-bold text-white mb-3"><i class="bi bi-exclamation-triangle text-danger"></i> Delete Movie</h2>
            <p class="text-secondary fs-5">Are you sure you want to permanently delete the movie <strong>@Model.Title</strong>?</p>
            <p class="text-danger small mb-4"><i class="bi bi-info-circle"></i> Warning: This action will delete all showtimes and bookings scheduled for this movie, and delete the uploaded poster image file.</p>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Delete Movie</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
