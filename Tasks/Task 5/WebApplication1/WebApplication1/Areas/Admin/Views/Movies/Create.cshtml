@model Movie
@{
    ViewData["Title"] = "Add Movie";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="glass-card p-5">
            <h2 class="fw-bold text-white mb-4"><i class="bi bi-camera-reels text-primary"></i> Add Movie</h2>
            
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Title" class="form-label">Movie Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Interstellar" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryId" class="form-label">Genre/Category</label>
                        <select asp-for="CategoryId" class="form-select bg-dark border-secondary text-white" asp-items="ViewBag.Categories">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description Synopsis</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Write movie details, cast, and plot summary..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="form-label">Duration (Minutes)</label>
                        <input asp-for="DurationMinutes" type="number" class="form-control" placeholder="e.g. 120" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReleaseDate" class="form-label">Release Date</label>
                        <input asp-for="ReleaseDate" class="form-control" type="date" />
                        <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Upload Poster Image</label>
                    <input type="file" name="posterFile" class="form-control" accept="image/*" />
                    <small class="text-muted d-block mt-1">Recommended aspect ratio: 2:3. Accepted formats: JPG, PNG, WEBP.</small>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Save Movie</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
