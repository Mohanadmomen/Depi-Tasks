@model Movie
@{
    ViewData["Title"] = "Edit Movie";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="glass-card p-5">
            <h2 class="fw-bold text-white mb-4"><i class="bi bi-pencil text-primary"></i> Edit Movie</h2>
            
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Title" class="form-label">Movie Title</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryId" class="form-label">Genre/Category</label>
                        <select asp-for="CategoryId" class="form-select bg-dark border-secondary text-white" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description Synopsis</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="form-label">Duration (Minutes)</label>
                        <input asp-for="DurationMinutes" type="number" class="form-control" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReleaseDate" class="form-label">Release Date</label>
                        <input asp-for="ReleaseDate" class="form-control" type="date" value="@Model.ReleaseDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row align-items-center mb-4">
                    <div class="col-sm-3 text-center">
                        <h6 class="text-secondary small fw-bold mb-2">Current Poster</h6>
                        @if (!string.IsNullOrEmpty(Model.PosterUrl))
                        {
                            <img src="@Model.PosterUrl" alt="Current Movie Poster" style="max-height: 120px; border-radius: 4px; border: 1px solid var(--border-glass);" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        }
                        <div class="bg-dark text-muted py-3 px-2 rounded border border-secondary" style="display: @(string.IsNullOrEmpty(Model.PosterUrl) ? "block" : "none");">
                            <i class="bi bi-image fs-4"></i><br><small>No Image</small>
                        </div>
                    </div>
                    
                    <div class="col-sm-9">
                        <label class="form-label">Change Poster Image</label>
                        <input type="file" name="posterFile" class="form-control" accept="image/*" />
                        <small class="text-muted d-block mt-1">Leave empty to keep the current poster. Recommended aspect ratio: 2:3.</small>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Update Movie</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
