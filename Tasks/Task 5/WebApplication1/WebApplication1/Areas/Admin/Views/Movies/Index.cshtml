@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Manage Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-white mb-1"><i class="bi bi-camera-reels text-primary"></i> Movie Manager</h1>
        <p class="text-secondary">Configure titles, descriptions, and upload poster graphics</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Movie</a>
</div>

<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-4">
            <p class="text-secondary mb-0">No movies found. Click 'Add Movie' to begin.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 80px;">Poster</th>
                        <th>Title</th>
                        <th>Genre</th>
                        <th>Duration</th>
                        <th>Release Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PosterUrl))
                                {
                                    <img src="@item.PosterUrl" alt="@item.Title Thumbnail" style="width: 50px; height: 75px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-glass);" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                }
                                <div class="bg-dark text-danger justify-content-center align-items-center" style="display: @(string.IsNullOrEmpty(item.PosterUrl) ? "flex" : "none"); width: 50px; height: 75px; border-radius: 4px; border: 1px solid var(--border-glass);">
                                    <i class="bi bi-film"></i>
                                </div>
                            </td>
                            <td class="text-white fw-semibold">@item.Title</td>
                            <td class="text-secondary">@item.Category?.Name</td>
                            <td class="text-secondary">@item.DurationMinutes min</td>
                            <td class="text-secondary">@item.ReleaseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm me-2"><i class="bi bi-pencil"></i> Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-trash"></i> Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
