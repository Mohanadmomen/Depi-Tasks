@model IEnumerable<Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-white mb-1"><i class="bi bi-tags text-primary"></i> Category Manager</h1>
        <p class="text-secondary">Configure movie genres and categories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create Genre</a>
</div>

<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-4">
            <p class="text-secondary mb-0">No categories found. Click 'Create Genre' to add one.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-white fw-semibold">@item.Name</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm me-2"><i class="bi bi-pencil"></i> Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-trash"></i> Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
