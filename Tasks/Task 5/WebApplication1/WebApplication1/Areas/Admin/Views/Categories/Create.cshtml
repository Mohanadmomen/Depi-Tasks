@model Category
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card p-5">
            <h2 class="fw-bold text-white mb-4"><i class="bi bi-tag text-primary"></i> Create Category</h2>
            
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Category Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Science Fiction" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Save Genre</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
