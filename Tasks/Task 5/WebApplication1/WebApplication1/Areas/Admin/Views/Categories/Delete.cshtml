@model Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card p-5 border-danger-subtle">
            <h2 class="fw-bold text-white mb-3"><i class="bi bi-exclamation-triangle text-danger"></i> Delete Category</h2>
            <p class="text-secondary fs-5 mb-4">Are you sure you want to permanently delete the category <strong>@Model.Name</strong>?</p>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Delete Category</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
