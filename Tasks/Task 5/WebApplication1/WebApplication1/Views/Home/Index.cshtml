@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="glass-card p-5 mb-5 text-center relative overflow-hidden" style="background: linear-gradient(135deg, rgba(229, 9, 20, 0.15) 0%, rgba(99, 102, 241, 0.1) 100%); border-color: rgba(229, 9, 20, 0.2);">
    <div class="py-5">
        <span class="badge badge-custom badge-active mb-3"><i class="bi bi-fire text-success"></i> Now Streaming in Theaters</span>
        <h1 class="display-3 fw-bold text-white mb-3">Cinema Reimagined</h1>
        <p class="lead text-secondary col-lg-8 mx-auto mb-4">Book your tickets for the latest blockbusters in premium halls, IMAX, and VIP lounges. Immersive sound, crystal-clear screens, and comfortable seats await you.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Movies" class="btn btn-primary py-3 px-5 fs-5">Browse Movies</a>
            <a asp-action="Cinemas" class="btn btn-secondary py-3 px-5 fs-5">Our Cinemas</a>
        </div>
    </div>
</div>

<!-- Featured Movies Section -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1">Now Showing</h2>
            <p class="text-secondary mb-0">Browse the latest movies showing this week</p>
        </div>
        <a asp-action="Movies" class="btn btn-secondary py-2 px-3">View All Movies <i class="bi bi-chevron-right"></i></a>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card p-5 text-center">
            <i class="bi bi-camera-reels text-muted fs-1 mb-3"></i>
            <h3 class="text-white">No Movies Found</h3>
            <p class="text-secondary">Please check back later or seed the database.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="glass-card movie-card">
                        <div class="movie-poster-wrapper">
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" class="movie-poster-img" alt="@movie.Title Poster" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            }
                            <div class="movie-poster-placeholder" style="display: @(string.IsNullOrEmpty(movie.PosterUrl) ? "flex" : "none");">
                                <i class="bi bi-film fs-1 mb-2 text-danger"></i>
                                <span class="fw-bold fs-5 text-white">@movie.Title</span>
                                <small class="text-muted mt-1">No Poster Available</small>
                            </div>
                            <div class="movie-card-overlay">
                                <span class="movie-badge mb-2">@movie.Category?.Name</span>
                                <h4 class="fw-bold text-white mb-1">@movie.Title</h4>
                                <p class="text-secondary small mb-3"><i class="bi bi-clock"></i> @movie.DurationMinutes min</p>
                                <a asp-action="MovieDetails" asp-route-id="@movie.Id" class="btn btn-primary w-100 py-2">Get Tickets</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Promo Banner Section -->
<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="glass-card p-4 d-flex align-items-center gap-4">
            <div class="fs-1 text-danger"><i class="bi bi-stars"></i></div>
            <div>
                <h4 class="fw-bold text-white mb-1">IMAX Experience</h4>
                <p class="text-secondary mb-0">Immerse yourself in crystal clear dual projection and theater sound.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glass-card p-4 d-flex align-items-center gap-4">
            <div class="fs-1 text-primary"><i class="bi bi-gem"></i></div>
            <div>
                <h4 class="fw-bold text-white mb-1">VIP Lounges</h4>
                <p class="text-secondary mb-0">Reclining seats, gourmet dining, and butler services at your call.</p>
            </div>
        </div>
    </div>
</div>
