@model IEnumerable<Booking>
@{
    ViewData["Title"] = "My Bookings";
    
    var upcomingBookings = Model.Where(b => b.Showtime?.StartTime > DateTime.Now && !b.IsCancelled).ToList();
    var pastAndCancelled = Model.Where(b => b.Showtime?.StartTime <= DateTime.Now || b.IsCancelled).ToList();
}

<div class="mb-4">
    <h1 class="fw-bold text-white mb-1">My Bookings</h1>
    <p class="text-secondary">Track your tickets, view schedules, and manage cancellations</p>
</div>

<!-- Upcoming Bookings -->
<div class="mb-5">
    <h3 class="fw-bold text-white mb-3"><i class="bi bi-calendar2-week text-primary me-2"></i> Upcoming Movies</h3>
    
    @if (!upcomingBookings.Any())
    {
        <div class="glass-card p-4 text-center">
            <p class="text-secondary mb-0">You have no upcoming movies booked. <a asp-controller="Home" asp-action="Movies" class="text-danger fw-semibold text-decoration-none">Browse movies to book tickets!</a></p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Movie</th>
                        <th>Showtime</th>
                        <th>Location</th>
                        <th>Seats</th>
                        <th>Total Paid</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in upcomingBookings)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-white">@booking.Showtime?.Movie?.Title</div>
                                <small class="text-muted">@booking.Showtime?.Movie?.Category?.Name</small>
                            </td>
                            <td>
                                <div class="text-white"><i class="bi bi-clock me-1"></i> @booking.Showtime?.StartTime.ToString("ddd, MMM dd")</div>
                                <small class="text-secondary">@booking.Showtime?.StartTime.ToString("h:mm tt")</small>
                            </td>
                            <td>
                                <div class="text-white">@booking.Showtime?.Hall?.Cinema?.Name</div>
                                <small class="text-secondary">@booking.Showtime?.Hall?.Name</small>
                            </td>
                            <td class="text-white fw-bold">@booking.SeatsBooked</td>
                            <td class="text-success fw-bold">@booking.TotalPrice.ToString("C")</td>
                            <td>
                                <form asp-action="CancelBooking" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                    <input type="hidden" name="bookingId" value="@booking.Id" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-trash"></i> Cancel Booking</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Past / Cancelled Bookings -->
<div>
    <h3 class="fw-bold text-white mb-3"><i class="bi bi-clock-history text-secondary me-2"></i> Booking History</h3>
    
    @if (!pastAndCancelled.Any())
    {
        <div class="glass-card p-4 text-center">
            <p class="text-secondary mb-0">No booking history available.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Movie</th>
                        <th>Showtime</th>
                        <th>Location</th>
                        <th>Seats</th>
                        <th>Total Paid</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in pastAndCancelled)
                    {
                        bool isPast = booking.Showtime?.StartTime <= DateTime.Now;
                        <tr>
                            <td>
                                <div class="fw-bold text-white">@booking.Showtime?.Movie?.Title</div>
                                <small class="text-muted">@booking.Showtime?.Movie?.Category?.Name</small>
                            </td>
                            <td>
                                <div class="text-white"><i class="bi bi-clock me-1"></i> @booking.Showtime?.StartTime.ToString("ddd, MMM dd")</div>
                                <small class="text-secondary">@booking.Showtime?.StartTime.ToString("h:mm tt")</small>
                            </td>
                            <td>
                                <div class="text-white">@booking.Showtime?.Hall?.Cinema?.Name</div>
                                <small class="text-secondary">@booking.Showtime?.Hall?.Name</small>
                            </td>
                            <td class="text-white">@booking.SeatsBooked</td>
                            <td class="text-white">@booking.TotalPrice.ToString("C")</td>
                            <td>
                                @if (booking.IsCancelled)
                                {
                                    <span class="badge badge-custom badge-cancelled">Cancelled</span>
                                }
                                else if (isPast)
                                {
                                    <span class="badge badge-custom badge-active">Completed</span>
                                }
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
